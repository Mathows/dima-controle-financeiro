@using Dima.Mobile.Security
@inject IUserContext UserContext
@implements IDisposable

<div class="d-flex flex-column align-center pa-6" style="background: rgba(30, 250, 45, 0.08);">
    <MudAvatar Color="Color.Primary" Size="Size.Large">@_initials</MudAvatar>
    <MudText Typo="Typo.h6" Class="mt-2">@_displayName</MudText>
    <MudText Typo="Typo.caption" Style="opacity: .7;">Controle Financeiro</MudText>
</div>

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="/lancamentos" Icon="@Icons.Material.Outlined.History">Lançamentos</MudNavLink>
    <MudNavLink Href="/categorias" Icon="@Icons.Material.Outlined.Category">Categorias</MudNavLink>
    <MudNavLink Href="/conta" Icon="@Icons.Material.Outlined.ManageAccounts">Conta</MudNavLink>
    <MudNavLink Href="/sair" Icon="@Icons.Material.Outlined.Logout">Sair</MudNavLink>
</MudNavMenu>

@code {
    private string _displayName = "Dima";
    private string _initials = "D";
    private string? _email;

    protected override async Task OnInitializedAsync()
    {
        var info = await UserContext.GetAsync();
        _displayName = info.DisplayName;
        _initials = info.Initials;
        _email = info.Email;
    }

    public void Dispose() { }
}
