@page "/categorias/novo"
@page "/categorias/editar/{Id}"
@using Dima.Core.Handlers
@using Dima.Core.Requests.Categories
@using Dima.Mobile.Security
@inject ICategoryHandler CategoryHandler
@inject ITokenStorage TokenStorage
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">@(IsEdit ? "Editar Categoria" : "Nova Categoria")</MudText>

@if (IsLoading)
{
    <div class="d-flex justify-center pa-8">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    </div>
}
else
{
    <MudTextField T="string"
                  Label="Título"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  DebounceInterval="0"
                  Value="@Title"
                  ValueChanged="@((string v) => Title = v ?? string.Empty)"/>

    <MudTextField T="string"
                  Label="Descrição"
                  Variant="Variant.Outlined"
                  Lines="3"
                  Immediate="true"
                  DebounceInterval="0"
                  Value="@Description"
                  ValueChanged="@((string v) => Description = v ?? string.Empty)"
                  Class="mt-3"/>

    <MudText Typo="Typo.body2" Class="mt-4 mb-1">Tipo</MudText>
    <MudRadioGroup T="ETransactionType" Value="@Type" ValueChanged="@((ETransactionType v) => Type = v)">
        <MudRadio T="ETransactionType" Value="ETransactionType.Deposit" Color="Color.Success">
            Entrada
        </MudRadio>
        <MudRadio T="ETransactionType" Value="ETransactionType.Withdraw" Color="Color.Error">
            Saída
        </MudRadio>
    </MudRadioGroup>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@ErrorMessage</MudAlert>
    }

    <div class="d-flex justify-end mt-6" style="gap: 8px;">
        <MudButton Href="/categorias" Variant="Variant.Text">Cancelar</MudButton>
        @if (IsSaving)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
        }
        else
        {
            <MudButton OnClick="OnSubmitAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@string.IsNullOrWhiteSpace(Title)">
                SALVAR
            </MudButton>
        }
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    public bool IsEdit => !string.IsNullOrEmpty(Id);

    public bool IsLoading { get; set; }
    public bool IsSaving { get; set; }
    public string? ErrorMessage { get; set; }

    public string Title { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public ETransactionType Type { get; set; } = ETransactionType.Withdraw;

    protected override async Task OnInitializedAsync()
    {
        var token = await TokenStorage.GetAccessTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (IsEdit && long.TryParse(Id, out var id))
        {
            IsLoading = true;
            try
            {
                var result = await CategoryHandler.GetByIdAsync(new GetCategoryByIdRequest { Id = id });
                if (result.IsSuccess && result.Data is not null)
                {
                    Title = result.Data.Title;
                    Description = result.Data.Description ?? string.Empty;
                    Type = result.Data.Type;
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = ex.Message;
            }
            finally
            {
                IsLoading = false;
            }
        }
    }

    private async Task OnSubmitAsync()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(Title))
        {
            ErrorMessage = "Preencha o título";
            return;
        }

        IsSaving = true;
        StateHasChanged();

        try
        {
            if (IsEdit && long.TryParse(Id, out var id))
            {
                var request = new UpdateCategoryRequest
                {
                    Id = id,
                    Title = Title,
                    Description = Description,
                    Type = Type
                };
                var result = await CategoryHandler.UpdateAsync(request);
                if (result.IsSuccess)
                {
                    Snackbar.Add("Categoria atualizada!", Severity.Success);
                    Navigation.NavigateTo("/categorias");
                }
                else
                {
                    ErrorMessage = result.Message ?? "Falha ao atualizar";
                }
            }
            else
            {
                var request = new CreateCategoryRequest
                {
                    Title = Title,
                    Description = Description,
                    Type = Type
                };
                var result = await CategoryHandler.CreateAsync(request);
                if (result.IsSuccess)
                {
                    Snackbar.Add("Categoria criada!", Severity.Success);
                    Navigation.NavigateTo("/categorias");
                }
                else
                {
                    ErrorMessage = result.Message ?? "Falha ao criar";
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}
