@inherits IncomesAndExpensesChartComponent

<div style="height: 350px; width: 100%; padding-left: 24px;">
    @if (Series is null)
    {
        <div class="d-flex align-center justify-center" style="height: 100%;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
        </div>
    }
    else if (Series.Count > 0 && Labels.Count > 0)
    {
        <MudChart
            ChartOptions="Options"
            ChartType="ChartType.Bar"
            ChartSeries="Series"
            XAxisLabels="Labels.ToArray()"
            CanHideSeries="true"
            Width="100%"
            Height="100%"/>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center" style="height: 100%; opacity: .6;">
            <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Large"/>
            <MudText Typo="Typo.body2" Class="mt-2">Sem dados nos últimos 12 meses.</MudText>
        </div>
    }
</div>
