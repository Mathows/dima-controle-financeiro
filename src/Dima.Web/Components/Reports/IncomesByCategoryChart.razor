@inherits IncomesByCategoryChartComponent

<div class="d-flex justify-center align-center" style="height: 350px; width: 100%;">
    @if (Data.Count > 0)
    {
        <MudChart
            ChartType="ChartType.Pie"
            InputData="@Data.ToArray()"
            InputLabels="@Labels.ToArray()"
            Width="320px"
            Height="320px"/>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    }
</div>
