@inherits IncomesByCategoryChartComponent

<div class="d-flex justify-center align-center" style="height: 350px; width: 100%;">
    @if (IsLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
    }
    else if (Data.Count > 0)
    {
        <MudChart
            ChartType="ChartType.Pie"
            InputData="@Data.ToArray()"
            InputLabels="@Labels.ToArray()"
            Width="320px"
            Height="320px"/>
    }
    else
    {
        <div class="d-flex flex-column align-center" style="opacity: .6;">
            <MudIcon Icon="@Icons.Material.Outlined.PieChart" Size="Size.Large"/>
            <MudText Typo="Typo.body2" Class="mt-2">Sem entradas neste período.</MudText>
        </div>
    }
</div>
