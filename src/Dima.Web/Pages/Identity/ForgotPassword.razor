@page "/esqueci-senha"
@layout HeadlessLayout
@inherits ForgotPasswordPage

<PageTitle>Dima - Esqueci minha senha</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6">
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pt-4">
                <img src="imgs/dima.png" alt="Dima - Controle Financeiro" width="160"/>
            </div>

            <div class="d-flex flex-column align-center pb-6">
                <MudText Typo="Typo.h5" Class="mt-2">Esqueceu sua senha?</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center">
                    Informe o e-mail da sua conta e enviaremos um link para criar uma nova senha.
                </MudText>
            </div>

            @if (SubmissionDone)
            {
                <MudAlert Severity="Severity.Success" Class="my-4">
                    Se este e-mail estiver cadastrado, você receberá em instantes uma mensagem com instruções para redefinir sua senha. Confira também a caixa de spam.
                </MudAlert>

                <div class="d-flex mt-6">
                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">Voltar para o login</MudButton>
                </div>
            }
            else
            {
                <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator/>

                    <MudTextField
                        T="string"
                        Label="E-mail"
                        InputType="InputType.Email"
                        For="@(() => InputModel.Email)"
                        @bind-Value="InputModel.Email"/>

                    <div class="d-flex mt-8">
                        @if (IsBusy)
                        {
                            <MudProgressCircular Color="Color.Info" Indeterminate="true"/>
                        }
                        else
                        {
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                                ENVIAR LINK
                            </MudButton>
                            <MudSpacer/>
                            <MudButton Href="/login">VOLTAR</MudButton>
                        }
                    </div>
                </EditForm>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
