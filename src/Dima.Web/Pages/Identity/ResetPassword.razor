@page "/redefinir-senha"
@layout HeadlessLayout
@inherits ResetPasswordPage

<PageTitle>Dima - Redefinir senha</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6">
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pt-4">
                <img src="imgs/dima.png" alt="Dima - Controle Financeiro" width="160"/>
            </div>

            <div class="d-flex flex-column align-center pb-6">
                <MudText Typo="Typo.h5" Class="mt-2">Criar nova senha</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default" Align="Align.Center">
                    Escolha uma nova senha para a sua conta.
                </MudText>
            </div>

            @if (TokenMissing)
            {
                <MudAlert Severity="Severity.Error" Class="my-4">
                    Link inválido ou expirado. Solicite um novo e-mail de redefinição de senha.
                </MudAlert>
                <div class="d-flex mt-4">
                    <MudButton Href="/esqueci-senha" Variant="Variant.Filled" Color="Color.Primary">
                        Solicitar novo link
                    </MudButton>
                </div>
            }
            else if (Success)
            {
                <MudAlert Severity="Severity.Success" Class="my-4">
                    Sua senha foi redefinida com sucesso! Você já pode entrar com a nova senha.
                </MudAlert>
                <div class="d-flex mt-4">
                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">
                        Ir para o login
                    </MudButton>
                </div>
            }
            else
            {
                <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator/>

                    <MudTextField
                        T="string"
                        Label="E-mail"
                        Value="@InputModel.Email"
                        Disabled="true"
                        ReadOnly="true"/>

                    <MudTextField
                        T="string"
                        Label="Nova senha"
                        HelperText="Mínimo 6 caracteres"
                        InputType="InputType.Password"
                        For="@(() => InputModel.NewPassword)"
                        @bind-Value="InputModel.NewPassword"
                        Class="mt-2"/>

                    <div class="d-flex mt-8">
                        @if (IsBusy)
                        {
                            <MudProgressCircular Color="Color.Info" Indeterminate="true"/>
                        }
                        else
                        {
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                                REDEFINIR SENHA
                            </MudButton>
                            <MudSpacer/>
                            <MudButton Href="/login">CANCELAR</MudButton>
                        }
                    </div>
                </EditForm>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
