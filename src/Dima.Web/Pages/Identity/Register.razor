@page "/comecar"
@layout HeadlessLayout
@inherits RegisterPage

<PageTitle>Dima - Criar conta</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6">
        <MudPaper Class="mud-width-full pa-8">
            <div class="d-flex justify-center pt-4">
                <img
                    src="imgs/dima.png"
                    alt="Dima - Controle Financeiro"
                    width="160"/>
            </div>

            <div class="d-flex flex-column align-center pb-6">
                <MudText Typo="Typo.h5" Class="mt-2">Criar sua conta</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    Leva menos de 1 minuto. Comece a controlar suas finanças hoje.
                </MudText>
            </div>

            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator/>

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField
                            T="string"
                            Label="Nome"
                            For="@(() => InputModel.FirstName)"
                            @bind-Value="InputModel.FirstName"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField
                            T="string"
                            Label="Sobrenome"
                            For="@(() => InputModel.LastName)"
                            @bind-Value="InputModel.LastName"/>
                    </MudItem>
                </MudGrid>

                <MudTextField
                    T="string"
                    Label="E-mail"
                    InputType="InputType.Email"
                    For="@(() => InputModel.Email)"
                    @bind-Value="InputModel.Email"
                    Class="mt-2"/>

                <MudTextField
                    T="string"
                    Label="Senha"
                    HelperText="Mínimo 6 caracteres"
                    InputType="InputType.Password"
                    For="@(() => InputModel.Password)"
                    @bind-Value="InputModel.Password"
                    Class="mt-2"/>

                <div class="d-flex mt-8">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Color="Color.Info" Indeterminate="true"/>
                    }
                    else
                    {
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">CRIAR CONTA</MudButton>
                        <MudSpacer/>
                        <MudButton Href="/login">JÁ TENHO UMA CONTA</MudButton>
                    }
                </div>

            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>
